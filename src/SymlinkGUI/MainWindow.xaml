<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SymlinkGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Symlink GUI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Symlink GUI" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Padding="24,4,24,24" Spacing="12">

                <TextBlock Text="Create a link" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                <!-- Source -->
                <Border x:Name="SourceCard" Style="{StaticResource CardStyle}" AllowDrop="True"
                        DragOver="SourceCard_DragOver" Drop="SourceCard_Drop">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Source" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="The existing file or folder the link will point to. You can also drag it here."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceBox" PlaceholderText="C:\Path\To\Original" AllowDrop="False"
                                     TextChanged="SourceBox_TextChanged" />
                            <Button Grid.Column="1" Click="BrowseSourceFile_Click" ToolTipService.ToolTip="Choose a file">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="File" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="BrowseSourceFolder_Click" ToolTipService.ToolTip="Choose a folder">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Folder" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="SourceInfoPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <FontIcon x:Name="SourceInfoIcon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SourceInfoText" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Destination -->
                <Border x:Name="DestinationCard" Style="{StaticResource CardStyle}" AllowDrop="True"
                        DragOver="DestinationCard_DragOver" Drop="DestinationCard_Drop">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Destination folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Where the new link will be created."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DestinationBox" PlaceholderText="C:\Path\To\Folder" AllowDrop="False"
                                     TextChanged="Input_TextChanged" />
                            <Button Grid.Column="1" Click="BrowseDestination_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="Browse" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Link Type -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Link type" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <RadioButtons x:Name="LinkTypeRadioButtons" SelectionChanged="LinkType_SelectionChanged" SelectedIndex="0">
                            <RadioButton x:Name="SymlinkRadio" Content="Symbolic Link" />
                            <RadioButton x:Name="JunctionRadio" Content="Directory Junction" />
                            <RadioButton x:Name="HardLinkRadio" Content="Hard Link" />
                        </RadioButtons>
                        <TextBlock x:Name="LinkTypeDescriptionText" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Border>

                <!-- Name -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Link name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="NameBox" PlaceholderText="Name of the link" TextChanged="NameBox_TextChanged" />
                        <TextBlock x:Name="PreviewText" Style="{StaticResource CardDescriptionStyle}"
                                   FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

                <!-- Actions -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ValidationText" VerticalAlignment="Center" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="CreateButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="False" Click="CreateButton_Click" MinWidth="160">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ShieldIcon" Glyph="&#xEA18;" FontSize="14" Visibility="Collapsed" />
                            <ProgressRing x:Name="CreateProgress" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="CreateButtonText" Text="Create Symbolic Link" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Settings -->
                <TextBlock Text="Explorer integration" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8DE;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Show in File Explorer context menu" />
                            <TextBlock Style="{StaticResource CardDescriptionStyle}"
                                       Text="Adds &quot;Pick as Link Source&quot;, &quot;Drop Link Here&quot; and &quot;Create Link To...&quot;. On Windows 11, find them under &quot;Show more options&quot;." />
                        </StackPanel>
                        <ToggleSwitch x:Name="ContextMenuToggle" Grid.Column="2" OnContent="On" OffContent="Off"
                                      MinWidth="0" Toggled="ContextMenuToggle_Toggled" />
                    </Grid>
                </Border>

                <InfoBar x:Name="StaleMenuBar" IsOpen="False" IsClosable="False" Severity="Warning"
                         Title="Context menu points to another location"
                         Message="The menu entries were registered from a different copy of this app (it may have been moved).">
                    <InfoBar.ActionButton>
                        <Button Content="Repair" Click="RepairMenu_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA18;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ElevationTitle" Text="Administrator permission" />
                            <TextBlock x:Name="ElevationDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
